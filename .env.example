# Public canonical URL used by deployment, SEO, and links inside transactional email
NEXT_PUBLIC_SITE_URL=https://handsonacademy.org.ng
# Supabase public project URL and publishable browser key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Phase 2: PostgreSQL connection string (never commit a real value)
DATABASE_URL=
# Google OAuth web client ID. Used by the Google Identity Services sign-in button so
# the handshake happens on this domain and the consent screen shows our branding
# instead of the Supabase project URL. Must also be listed under Supabase
# Authentication -> Providers -> Google -> Client IDs.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile (create a widget for handsonacademy.org.ng)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Transactional email via Resend. Without RESEND_API_KEY the app still works and
# logs each email it would have sent, rather than pretending delivery succeeded.
RESEND_API_KEY=
# Verified sender on your domain, e.g. HandsOn Academy <noreply@handsonacademy.org.ng>
EMAIL_FROM=
# Where applicant replies should land, e.g. hello@handsonacademy.org.ng
EMAIL_REPLY_TO=
# Applying sends no email to anyone, applicant or admin. The approval and decline
# messages are the only email this system produces. New applications are found in
# /admin/inquiries.
